# Copy this file to ".env" and fill it in.

# From console.anthropic.com -> API keys. This is what writes the messages.
ANTHROPIC_API_KEY=sk-ant-...

# The password to get into the app. Pick anything; you'll type it once.
APP_PASSWORD=change-me

# Keeps you logged in across restarts. Any long random string.
SESSION_SECRET=change-me-to-something-random

# Which port to open the app on. If this one is already being used by something
# else, the app quietly moves to the next free one and tells you which.
PORT=4600

# Where the database file lives. Leave as-is unless you're hosting it.
# DATA_DIR=/data
