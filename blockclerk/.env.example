# Copy this file to ".env" and fill it in.

# The password to get into the app. Pick anything; you'll type it once.
# Leave it out entirely if you're only running this on your own machine.
APP_PASSWORD=change-me

# Keeps you signed in across restarts. Any long random string.
SESSION_SECRET=change-me-to-something-random

# Which port to open the app on. If this one is already being used by
# something else, the app moves to the next free one and tells you which.
PORT=4700

# Where the database file lives. Leave as-is unless you're hosting it.
# DATA_DIR=/data
